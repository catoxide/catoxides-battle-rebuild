{
  "schemaVersion": 1,
  "configs": [
    {
      "id": "map",
      "scope": "CLIENT",
      "file": "map-pack-v2-client",
      "sections": [
        {
          "key": "hud",
          "values": [
            {
              "key": "enabled",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Show the minimap in the top-right corner."
              ]
            },
            {
              "key": "size",
              "type": "int",
              "default": 128,
              "tier": "HOT",
              "min": 64,
              "max": 256,
              "comment": [
                "Minimap edge length in screen pixels."
              ]
            },
            {
              "key": "blocksPerPixel",
              "type": "int",
              "default": 2,
              "tier": "HOT",
              "min": 1,
              "max": 8,
              "comment": [
                "How many blocks one minimap pixel covers. 1 is the finest (1 pixel per block)."
              ]
            },
            {
              "key": "showBiome",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Show the biome name under the minimap."
              ]
            },
            {
              "key": "showTime",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Show the current in-game time under the minimap."
              ]
            }
          ]
        },
        {
          "key": "map",
          "values": [
            {
              "key": "fullscreenBlocks",
              "type": "int",
              "default": 1024,
              "tier": "HOT",
              "min": 256,
              "max": 8192,
              "comment": [
                "World-map view width in blocks at zoom 1x. Mouse wheel changes zoom in game."
              ]
            },
            {
              "key": "zoomSharpen",
              "type": "int",
              "default": 0,
              "tier": "HOT",
              "min": 0,
              "max": 100,
              "comment": [
                "Sharpening applied to zoomed-out map tiles (0 = off, 100 = strongest).",
                "Zooming out averages blocks into one pixel; this restores local contrast."
              ]
            },
            {
              "key": "showBlockInfo",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Hovering the world map shows block name, biome and coordinates.",
                "Only loaded chunks are queried; unknown areas show nothing."
              ]
            },
            {
              "key": "showBiomePrediction",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Show predicted biomes for unexplored areas (needs biome-preview-pack).",
                "Prediction is drawn dimmed; real explored terrain always wins."
              ]
            },
            {
              "key": "predictionHover",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "When hovering an unloaded area, show the predicted biome instead of nothing.",
                "Requires showBiomePrediction."
              ]
            },
            {
              "key": "predictionOutline",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Draw a darker outline between different predicted biomes (jelly-block look)."
              ]
            },
            {
              "key": "inheritPrompt",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "When entering a new world whose seed matches an existing map, ask whether to inherit it.",
                "Inheritance copies the old map into this world; the two stay independent."
              ]
            },
            {
              "key": "markerSound",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": "Play a sound when another player's marker arrives."
            },
            {
              "key": "structureOverlay",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": [
                "Show structure locations on the world map.",
                "Positions are computed by the server; no chunks are generated."
              ]
            },
            {
              "key": "structureMaxBpp",
              "type": "double",
              "default": 1.0,
              "tier": "HOT",
              "min": 0.125,
              "max": 8.0,
              "comment": [
                "Hide the structure overlay when one canvas pixel covers more blocks than this.",
                "Zoom in past this value to see structures; larger values are denser."
              ]
            }
          ]
        },
        {
          "key": "compass",
          "values": [
            {
              "key": "fovTicks",
              "type": "bool",
              "default": false,
              "tier": "HOT",
              "comment": [
                "false: fixed 110-degree window, 15-degree ticks (default).",
                "true:  the bar spans your field of view, so tick spacing simulates real angles."
              ]
            },
            {
              "key": "numberOnly",
              "type": "bool",
              "default": false,
              "tier": "HOT",
              "comment": "true: show only the current bearing number (hide bar/ticks)."
            },
            {
              "key": "thickBar",
              "type": "bool",
              "default": false,
              "tier": "HOT",
              "comment": "true: taller bar; false: normal/thin bar (default)."
            },
            {
              "key": "width",
              "type": "int",
              "default": 300,
              "tier": "HOT",
              "min": 120,
              "max": 600,
              "comment": [
                "Compass bar width in screen pixels, also capped by the screen width.",
                "Drag the corner grip in the HUD layout editor to change it."
              ]
            },
            {
              "key": "frostedBackground",
              "type": "bool",
              "default": true,
              "tier": "HOT",
              "comment": "true: frosted black background (default); false: no background."
            },
            {
              "key": "alignMode",
              "type": "int",
              "default": 0,
              "tier": "HOT",
              "min": 0,
              "max": 2,
              "comment": [
                "0: perspective - follow game FOV with tan projection (matches on-screen direction).",
                "1: center only - fixed reference FOV with adjustable spread.",
                "2: linear - fixed 110 degree window (legacy)."
              ]
            },
            {
              "key": "referenceFov",
              "type": "int",
              "default": 70,
              "tier": "HOT",
              "min": 30,
              "max": 120,
              "comment": "Reference FOV used by alignMode=1."
            },
            {
              "key": "compassScale",
              "type": "double",
              "default": 1.0,
              "tier": "HOT",
              "min": 0.4,
              "max": 2.5,
              "comment": [
                "Horizontal spread when alignMode=1. Center stays aligned; larger = ticks spread out."
              ]
            },
            {
              "key": "markerScale",
              "type": "double",
              "default": 1.5,
              "tier": "HOT",
              "min": 0.5,
              "max": 3.0,
              "comment": "Size of marker symbols on the compass bar. 1.0 = original size."
            },
            {
              "key": "textStyle",
              "type": "int",
              "default": 1,
              "tier": "HOT",
              "min": 0,
              "max": 2,
              "comment": [
                "0: no text effect, 1: vanilla shadow (default), 2: four-way outline.",
                "Outline uses translucent dark grey, not a solid black border."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "server",
      "scope": "SERVER",
      "file": "map-pack-server",
      "defaultTier": "HOT",
      "sections": [
        {
          "key": "markers",
          "values": [
            {
              "key": "shareMarkers",
              "type": "bool",
              "default": true,
              "comment": "Share markers between players. Turn off for public servers."
            },
            {
              "key": "shareAllDimensions",
              "type": "bool",
              "default": true,
              "comment": "Also show markers from other dimensions."
            },
            {
              "key": "markerRange",
              "type": "int",
              "default": 0,
              "min": 0,
              "max": 8192,
              "comment": "Only share markers within this radius in blocks. 0 = unlimited."
            },
            {
              "key": "pingSeconds",
              "type": "int",
              "default": 10,
              "min": 1,
              "max": 120,
              "comment": [
                "How long a temporary marker (ping / item / entity / container) stays visible.",
                "Marking the same target again refreshes this timer."
              ]
            },
            {
              "key": "deathMarkerRadius",
              "type": "double",
              "default": 3.0,
              "min": 0.5,
              "max": 16.0,
              "comment": "A death marker disappears after its owner gets this close (blocks)."
            }
          ]
        },
        {
          "key": "structures",
          "values": [
            {
              "key": "enabled",
              "type": "bool",
              "default": true,
              "comment": [
                "Answer structure-map queries from players.",
                "Positions come from worldgen placement maths only; no chunks are generated."
              ]
            },
            {
              "key": "minSpacing",
              "type": "int",
              "default": 8,
              "min": 1,
              "max": 128,
              "comment": [
                "Skip structure sets placed closer together than this (in chunks).",
                "Buried treasures, mineshafts and nether fossils use spacing 1-2 and are ~100x denser."
              ]
            },
            {
              "key": "maxResults",
              "type": "int",
              "default": 256,
              "min": 16,
              "max": 4096,
              "comment": "Upper bound on structure candidates returned per map cell."
            },
            {
              "key": "budgetMillis",
              "type": "int",
              "default": 8,
              "min": 1,
              "max": 100,
              "comment": "Soft time budget for one map cell scan; the result is marked truncated when exceeded."
            },
            {
              "key": "requestsPerSecond",
              "type": "int",
              "default": 8,
              "min": 1,
              "max": 64,
              "comment": "Per-player limit on structure-map queries."
            },
            {
              "key": "verifyBiomes",
              "type": "bool",
              "default": true,
              "comment": [
                "Drop candidates whose biome cannot host that structure.",
                "Sampled without generating chunks; turning this off brings back most false positives."
              ]
            },
            {
              "key": "showModdedSets",
              "type": "bool",
              "default": false,
              "comment": [
                "Also list structure sets from other namespaces (mods / datapacks).",
                "They use the same placement maths but their icons and names are not verified yet."
              ]
            }
          ]
        }
      ]
    }
  ]
}
