{
  "schemaVersion": 1,
  "configs": [
    {
      "id": "sablemap",
      "scope": "CLIENT",
      "file": "sable-map-client",
      "defaultTier": "HOT",
      "sections": [
        {
          "key": "layer",
          "values": [
            {
              "key": "enabled",
              "type": "bool",
              "default": true,
              "comment": [
                "Draw Sable sub-levels and entities standing on them on the map."
              ]
            },
            {
              "key": "showShips",
              "type": "bool",
              "default": true,
              "comment": "Draw the top-down snapshot of each sub-level."
            },
            {
              "key": "showEntities",
              "type": "bool",
              "default": true,
              "comment": [
                "Draw living entities standing on sub-levels, including other players.",
                "The local player keeps the map's normal red dot."
              ]
            },
            {
              "key": "showOnMinimap",
              "type": "bool",
              "default": true,
              "comment": "Also draw the layer on the corner minimap."
            },
            {
              "key": "showOnFullmap",
              "type": "bool",
              "default": true,
              "comment": "Also draw the layer on the full-screen world map."
            },
            {
              "key": "opacity",
              "type": "double",
              "default": 1.0,
              "min": 0.2,
              "max": 1.0,
              "comment": "Opacity of the sub-level snapshot (0.2 - 1.0)."
            },
            {
              "key": "maxTexture",
              "type": "int",
              "default": 768,
              "min": 64,
              "max": 1024,
              "comment": [
                "Pixel budget for the longest edge of a sub-level snapshot texture.",
                "Ships are sampled at up to 16 pixels per block; only larger ships are downsampled.",
                "Lower values save memory and readback time."
              ]
            }
          ]
        }
      ]
    }
  ]
}
